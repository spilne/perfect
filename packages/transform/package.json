{
  "name": "@perfect/transform",
  "version": "0.1.0",
  "description": "Build-time compiler for Perfect's eff(($) => …) and for-comprehension syntaxes (Bun plugin).",
  "keywords": [
    "bun-plugin",
    "effect",
    "for-comprehension",
    "transform"
  ],
  "homepage": "https://github.com/spilne/perfect#readme",
  "bugs": {
    "url": "https://github.com/spilne/perfect/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spilne/perfect.git",
    "directory": "packages/transform"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "main": "dist/rewrite.js",
  "types": "dist/types/rewrite.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/rewrite.d.ts",
      "default": "./dist/rewrite.js"
    },
    "./bun-plugin": {
      "types": "./dist/types/bun-plugin.d.ts",
      "default": "./dist/bun-plugin.js"
    },
    "./plugin": {
      "types": "./dist/types/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./preload": {
      "types": "./dist/types/preload.d.ts",
      "default": "./dist/preload.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.src.json --noEmit",
    "build": "bun ../../scripts/build-package.ts ."
  },
  "devDependencies": {
    "@swc/core": "~1.15.47"
  }
}
