{
  "name": "@perfect/http",
  "version": "0.1.0",
  "description": "HTTP client on the Perfect effect runtime — typed errors, retries, streaming (SSE/NDJSON), mockable transport.",
  "keywords": [
    "client",
    "effect",
    "fetch",
    "http",
    "ndjson",
    "sse"
  ],
  "homepage": "https://github.com/spilne/perfect#readme",
  "bugs": {
    "url": "https://github.com/spilne/perfect/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spilne/perfect.git",
    "directory": "packages/http"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.src.json --noEmit",
    "build": "bun ../../scripts/build-package.ts .",
    "bench": "bun run bench/vs-clients.ts"
  },
  "dependencies": {
    "@perfect/core": "^0.1.0"
  },
  "devDependencies": {
    "axios": "^1.19.0",
    "mitata": "^1.0.34",
    "node-fetch": "^3.3.2",
    "undici": "^8.10.0",
    "valibot": "^1.4.2",
    "zod": "^4.4.3"
  }
}
