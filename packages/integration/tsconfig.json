{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noEmit": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["bun"],
    "typeRoots": ["../../node_modules/@types"],
    "paths": {
      "@spilne/perfect-core": ["../core/src/index.ts"],
      "@spilne/perfect-core/*": ["../core/src/*"],
      "@spilne/perfect-kafka": ["../kafka/src/index.ts"],
      "@spilne/perfect-kafka/*": ["../kafka/src/*"],
      "@spilne/perfect-kafka-kafkajs": ["../kafka-kafkajs/src/index.ts"],
      "@spilne/perfect-kafka-platformatic": ["../kafka-platformatic/src/index.ts"]
    }
  },
  "include": ["src", "test"]
}
