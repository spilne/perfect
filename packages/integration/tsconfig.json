{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noEmit": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["bun"],
    "typeRoots": ["../../node_modules/@types"],
    "paths": {
      "@perfect/core": ["../core/src/index.ts"],
      "@perfect/core/*": ["../core/src/*"],
      "@perfect/kafka": ["../kafka/src/index.ts"],
      "@perfect/kafka/*": ["../kafka/src/*"],
      "@perfect/kafka-kafkajs": ["../kafka-kafkajs/src/index.ts"],
      "@perfect/kafka-platformatic": ["../kafka-platformatic/src/index.ts"]
    }
  },
  "include": ["src", "test"]
}
