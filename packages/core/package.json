{
  "name": "@perfect/core",
  "version": "0.0.1",
  "description": "TypeScript effect runtime — Eff<A,S> with typed errors and dependencies, fibers, structured concurrency, pull-based streams, and messaging contracts.",
  "keywords": [
    "cats-effect",
    "effect",
    "fiber",
    "stream",
    "structured-concurrency",
    "typescript",
    "zio"
  ],
  "homepage": "https://github.com/spilne/perfect#readme",
  "bugs": {
    "url": "https://github.com/spilne/perfect/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spilne/perfect.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./stream": {
      "types": "./dist/types/stream/index.d.ts",
      "default": "./dist/stream/index.js"
    },
    "./connect": {
      "types": "./dist/types/connect/index.d.ts",
      "default": "./dist/connect/index.js"
    },
    "./syntax": {
      "types": "./dist/types/syntax/index.d.ts",
      "default": "./dist/syntax/index.js"
    },
    "./syntax/*": {
      "types": "./dist/types/syntax/*.d.ts",
      "default": "./dist/syntax/*.js"
    },
    "./worker": {
      "types": "./dist/types/worker/index.d.ts",
      "default": "./dist/worker/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test",
    "build": "bun ../../scripts/build-package.ts .",
    "typecheck": "tsc -p tsconfig.src.json --noEmit",
    "typecheck:types": "tsc -p tsconfig.type-tests.json --noEmit",
    "bench": "bun run bench/index.ts"
  },
  "devDependencies": {
    "effect": "^3.21.0",
    "mitata": "^1.0.34"
  }
}
