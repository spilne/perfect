{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "declarationDir": "dist/types",
    "paths": {
      "@spilne/perfect-core": ["../core/dist/types/index.d.ts"],
      "@spilne/perfect-core/*": ["../core/dist/types/*"],
      "@spilne/perfect-http": ["../http/dist/types/index.d.ts"],
      "@spilne/perfect-http/*": ["../http/dist/types/*"]
    }
  },
  "include": ["src"]
}
