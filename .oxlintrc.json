{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/target/**"
  ],
  "rules": {
    "unicorn/no-new-array": "off",
    "unicorn/no-thenable": "off",
    "require-yield": "off",
    "@typescript-eslint/no-this-alias": "off",
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "typescript/no-explicit-any": "error"
  },
  "overrides": [
    {
      "files": [
        "packages/core/src/stream/driver-lifecycle.ts",
        "packages/core/src/stream/fusion.ts",
        "packages/core/src/stream/par-join.ts",
        "packages/core/src/stream/pipes.ts",
        "packages/core/src/stream/push-source.ts",
        "packages/core/src/stream/raw-stream.ts",
        "packages/core/src/stream/stream.ts"
      ],
      "rules": {
        "typescript/no-explicit-any": "off"
      }
    }
  ]
}
