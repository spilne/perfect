{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["**/node_modules/**", "**/dist/**", "**/target/**"],
  "rules": {
    "unicorn/no-new-array": "off",
    "unicorn/no-thenable": "off",
    "require-yield": "off",
    "@typescript-eslint/no-this-alias": "off"
  }
}
