{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": ["default"],
    "sharedGlobals": []
  },
  "targetDefaults": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "commands": ["bun run build"],
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^typecheck"],
      "options": {
        "commands": ["bun run typecheck"],
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["bun test --pass-with-no-tests"],
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["oxlint -c .oxlintrc.json {projectRoot}"],
        "cwd": "{workspaceRoot}"
      },
      "inputs": ["default", "{workspaceRoot}/.oxlintrc.json"]
    },
    "ci": {
      "executor": "nx:noop",
      "dependsOn": ["typecheck", "lint", "test", "^ci"]
    }
  },
  "pluginsConfig": {
    "@nx/js": {
      "analyzeSourceFiles": false,
      "analyzeLockfile": false
    }
  },
  "analytics": false,
  "release": {
    "projects": ["packages/*", "templates/*", "!@spilne/perfect-integration"],
    "projectsRelationship": "fixed",
    "releaseTag": {
      "pattern": "v{version}"
    },
    "version": {
      "currentVersionResolver": "disk",
      "preserveMatchingDependencyRanges": false,
      "adjustSemverBumpsForZeroMajorVersion": false,
      "versionActionsOptions": {
        "installIgnoreScripts": true
      }
    },
    "changelog": {
      "workspaceChangelog": {
        "createRelease": false,
        "renderOptions": {
          "authors": false
        }
      },
      "projectChangelogs": false
    },
    "git": {
      "commit": true,
      "tag": true,
      "push": false,
      "commitMessage": "chore(release): {version}"
    }
  }
}
