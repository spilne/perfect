{
  "name": "perfect",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "test": "bun test --recursive packages/",
    "test:core": "cd packages/core && bun test",
    "test:transform": "cd packages/transform && bun test",
    "lint": "oxlint -c .oxlintrc.json packages/",
    "fmt": "oxfmt packages/",
    "fmt:check": "oxfmt --check packages/",
    "format": "bun run fmt",
    "bench": "cd packages/core && bun run bench/index.ts",
    "bench:vs-effect": "cd packages/core && bun run bench/vs-effect-ts.ts",
    "documentation:build": "bun documentation/build.ts",
    "documentation:check": "bun documentation/build.ts --check",
    "documentation:dev": "bun documentation/build.ts && vitepress dev documentation",
    "documentation:build:html": "bun documentation/build.ts && vitepress build documentation",
    "documentation:preview": "vitepress preview documentation",
    "build:rust": "cd crates/perfect-transform && cargo build --release",
    "build:swc": "cd crates/swc-plugin-perfect && cargo build --target wasm32-wasip1 --release && mkdir -p ../../packages/swc-plugin/dist && cp target/wasm32-wasip1/release/swc_plugin_perfect.wasm ../../packages/swc-plugin/dist/plugin.wasm"
  },
  "devDependencies": {
    "@nx/js": "^22.6.5",
    "@types/markdown-it-container": "^4.0.0",
    "markdown-it-container": "^4.0.0",
    "nx": "^22.6.5",
    "oxfmt": "^0.26.0",
    "oxlint": "^1.41.0",
    "rxjs": "^7.8.2",
    "typescript": "^6.0.2",
    "vitepress": "^1.6.4"
  }
}
